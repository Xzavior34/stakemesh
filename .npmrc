# Ignore postinstall scripts during npm ci.
# Required because @stellar/stellar-sdk ships a postinstall that calls
# `yarn setup || true` — the `|| true` idiom does not work on cmd.exe so
# npm exits non-zero on Windows. All native binaries ship pre-built .node
# files and do not require script execution to load correctly.
ignore-scripts=true

# Tolerate peer dependency conflicts caused by the React 19 / wallet-adapter
# ecosystem using peer ranges that don't yet declare React 19 support.
legacy-peer-deps=true
